# Copy this file to .env and replace the values with your own configuration.
# Do not commit your actual credentials or secret keys.

# Hanko API URL from the Hanko Console:
HANKO_API_URL=https://your-hanko-api-url.hanko.io

# Django configuration
DJANGO_SECRET_KEY=django-insecure-change-me
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
# Space or comma-separated trusted origins for CSRF checking (e.g., https://xps-server.kanyu-bluegill.ts.net)
CSRF_TRUSTED_ORIGINS=https://your-email.domain.com

# PostgreSQL configuration
POSTGRES_DB=open_garage
POSTGRES_USER=open_garage_user
POSTGRES_PASSWORD=change-me
# Use localhost when Django runs on the host via make run.
# Use db only when Django itself runs as a docker-compose service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
